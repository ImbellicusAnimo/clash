{
 "hooks": {
 "PreToolUse": [{
 "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
 "hooks": [{ "type": "command",
 "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-sensitive-paths.sh" }]
 }],
 "PostToolUse": [{
 "matcher": "Edit|Write",
 "hooks": [{ "type": "command",
 "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-with-prettier.sh" }]
 }]
 }
}
